@{
    ViewData["Title"] = "Beklenmeyen Bir Hata Oluştu";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="no-bottom no-top" id="content">
    <div id="top"></div>

    <!-- Subheader -->
    <section id="subheader" class="jarallax text-light">
        <img src="~/rentaly-ui/Rentaly HTML/images/background/subheader.jpg" class="jarallax-img" alt="">
        <div class="center-y relative text-center">
            <div class="container">
                <div class="row">
                    <div class="col-md-12 text-center">
                        <h1>Hata</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hata İçerik Alanı -->
    <section aria-label="section" class="pt80 pb80">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8 offset-md-2 text-center">
                    <h2 class="style-2" style="font-size: 80px; font-weight: bold; color: #e74c3c; margin-bottom: 20px;">Oops!</h2>
                    <h3 class="mb-4">İşleminiz sırasında beklenmeyen bir hata oluştu.</h3>
                    <p class="lead mb-4 text-muted">Teknik ekibimiz durumdan haberdar edildi. Ana sayfaya dönebilir veya tekrar deneyebilirsiniz.</p>
                    <a href="/" class="btn-main">Ana Sayfaya Dön</a>
                </div>
            </div>
        </div>
    </section>
</div>