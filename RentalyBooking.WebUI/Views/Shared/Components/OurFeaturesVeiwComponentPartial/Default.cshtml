@using RentalyBooking.EntityLayer.Entities
@model List<OurFeature>


<section aria-label="section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 offset-lg-3 text-center">
                <h2>Özelliklerimiz</h2>
                <p>Kolaylık, güvenlik ve özelleştirilebilir çözümler dünyasını keşfedin.</p>
                <div class="spacer-20"></div>
            </div>
            <div class="clearfix"></div>
            <div class="col-lg-3">

                <div class="box-icon s2 p-small mb20 wow fadeInRight" data-wow-delay=".5s">
                    <i class="fa bg-color fa-trophy"></i>
                    <div class="d-inner">
                        <h4>@Model?.Take(1).FirstOrDefault()?.FeatureName</h4>
                        @Model?.Take(1).FirstOrDefault()?.FeatureDescription
                    </div>
                </div>
                <div class="box-icon s2 p-small mb20 wow fadeInL fadeInRight" data-wow-delay=".75s">
                    <i class="fa bg-color fa-road"></i>
                    <div class="d-inner">
                        <h4>@Model?.Take(2).LastOrDefault()?.FeatureName</h4>
                        @Model?.Take(2).LastOrDefault()?.FeatureDescription
                    </div>
                </div>

            </div>

            <div class="col-lg-6">
                <img src="~/rentaly-ui/Rentaly HTML/images/misc/car-2.png" alt="" class="img-fluid wow fadeInUp">
            </div>

            <div class="col-lg-3">
                <div class="box-icon s2 d-invert p-small mb20 wow fadeInL fadeInLeft" data-wow-delay="1s">
                    <i class="fa bg-color fa-tag"></i>
                    <div class="d-inner">
                        <h4>@Model?.Take(3).LastOrDefault()?.FeatureName</h4>
                        @Model?.Take(3).LastOrDefault()?.FeatureDescription
                    </div>
                </div>
                <div class="box-icon s2 d-invert p-small mb20 wow fadeInL fadeInLeft" data-wow-delay="1.25s">
                    <i class="fa bg-color fa-map-pin"></i>
                    <div class="d-inner">
                        <h4>@Model?.Take(4).LastOrDefault()?.FeatureName</h4>
                        @Model?.Take(4).LastOrDefault()?.FeatureDescription
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>