@using RentalyBooking.WebUI.Models
@model RentalyBooking.WebUI.Models.CarFilterResultViewModel

@{
    ViewData["Title"] = "ListAllCars";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!-- content begin -->
<div class="no-bottom no-top zebra" id="content">
    <div id="top"></div>

    <!-- section begin -->
    <section id="subheader" class="jarallax text-light">
        <img src="/rentaly-ui/Rentaly HTML/images/background/2.jpg" class="jarallax-img" alt="">
        <div class="center-y relative text-center">
            <div class="container">
                <div class="row">
                    <div class="col-md-12 text-center">
                        <h1>Cars</h1>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
    </section>
    <!-- section close -->
    <section id="section-cars">
        <div class="container">
            <div class="row">
                <div class="col-lg-3">
                    <form id="filterForm" asp-controller="Car" asp-action="ListAllCars" method="get">
                        <div class="item_filter_group">
                            <h4>Araç Tipi</h4>
                            <div class="de_form">
                                @foreach (var item in Model.Categories)
                                {
                                    <div class="de_checkbox">
                                        <input class="single-select"
                                               type="checkbox"
                                               name="CategoryId"
                                               id="category_@item.CategoryId"
                                               value="@item.CategoryId"
                                        @(Model.CategoryId == item.CategoryId ? "checked" : "")>

                                        <label for="category_@item.CategoryId">@item.CategoryName</label>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="item_filter_group">
                            <h4>Koltuk </h4>
                            <div class="de_form">
                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="SeatCount"
                                           type="checkbox"
                                           value="2"
                                           id="seat_1"
                                    @(Model.SeatCount == 2 ? "checked" : "")>

                                    <label for="seat_1">2 Koltuk</label>
                                </div>

                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="SeatCount"
                                           type="checkbox"
                                           value="4"
                                           id="seat_2"
                                    @(Model.SeatCount == 4 ? "checked" : "")>

                                    <label for="seat_2">4 Koltuk</label>
                                </div>

                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="SeatCount"
                                           type="checkbox"
                                           value="5"
                                           id="seat_3"
                                    @(Model.SeatCount == 5 ? "checked" : "")>

                                    <label for="seat_3">5 Koltuk</label>
                                </div>

                            </div>
                        </div>

                        <div class="item_filter_group">
                            <h4>Yakıt Tipi</h4>
                            <div class="de_form">
                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="FuelType"
                                           type="checkbox"
                                           id="fuel_benzin"
                                           value="1"
                                    @(Model.FuelType != null && Model.FuelType.Contains(RentalyBooking.EntityLayer.Enums.FuelType.Benzin) ? "checked" : "") />
                                    <label for="fuel_benzin">Benzin</label>
                                </div>
                            </div>

                            <div class="de_form">
                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="FuelType"
                                           type="checkbox"
                                           id="fuel_dizel"
                                           value="2"
                                    @(Model.FuelType != null && Model.FuelType.Contains(RentalyBooking.EntityLayer.Enums.FuelType.Dizel) ? "checked" : "") />
                                    <label for="fuel_dizel">Dizel</label>
                                </div>
                            </div>

                            <div class="de_form">
                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="FuelType"
                                           type="checkbox"
                                           id="fuel_lpg"
                                           value="3"
                                    @(Model.FuelType != null && Model.FuelType.Contains(RentalyBooking.EntityLayer.Enums.FuelType.Lpg) ? "checked" : "") />
                                    <label for="fuel_lpg">Lpg</label>
                                </div>
                            </div>

                            <div class="de_form">
                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="FuelType"
                                           type="checkbox"
                                           id="fuel_elektrik"
                                           value="4"
                                    @(Model.FuelType != null && Model.FuelType.Contains(RentalyBooking.EntityLayer.Enums.FuelType.Elektrik) ? "checked" : "") />
                                    <label for="fuel_elektrik">Elektrik</label>
                                </div>
                            </div>

                            <div class="de_form">
                                <div class="de_checkbox">
                                    <input class="single-select"
                                           name="FuelType"
                                           type="checkbox"
                                           id="fuel_hibrit"
                                           value="5"
                                    @(Model.FuelType != null && Model.FuelType.Contains(RentalyBooking.EntityLayer.Enums.FuelType.Hibrit) ? "checked" : "") />
                                    <label for="fuel_hibrit">Hibrit</label>
                                </div>
                            </div>
                        </div>

                        <div class="item_filter_group">
                            <h4>Price ($)</h4>
                            <div class="price-input">
                                <div class="field">
                                    <span>Min</span>
                                    <input type="number" name="MinPrice" class="input-min" value="@(Model?.MinPrice ?? 0)">
                                </div>
                                <div class="field">
                                    <span>Max</span>
                                    <input type="number" name="MaxPrice" class="input-max" value="@(Model?.MaxPrice ?? 0)">
                                </div>
                            </div>
                            <div class="slider">
                                <div class="progress"></div>
                            </div>
                            <div class="range-input">
                                <input type="range" class="range-min" min="0" max="50000" step="1" value="@(Model?.MinPrice ?? 0)">
                                <input type="range" class="range-max" min="0" max="50000" step="1" value="@(Model?.MaxPrice ?? 50000)">
                            </div>
                        </div>
                    </form>
                </div>

                <div class="col-lg-9">
                    <div class="row">
                        @foreach (var item in Model.Cars)
                        {
                            <div class="col-xl-4 col-lg-6 mb-4">
                                <div class="de-item h-100 d-flex flex-column">
                                    <div class="d-img">
                                        <img src="@item.ImageUrl" class="img-fluid" alt="" style="height: 250px; object-fit: contain; width: 100%;">
                                    </div>
                                    <div class="d-info flex-grow-1">
                                        <div class="d-text">
                                            <h4>@item.Brand.BrandName @item.CarModel.ModelName</h4>
                                            <div class="d-atr-group d-flex flex-wrap">

                                                <span class="d-atr"><img src="/rentaly-ui/Rentaly HTML/images/icons/1-green.svg" alt="">@item.SeatCount</span>
                                                <span class="d-atr"><img src="/rentaly-ui/Rentaly HTML/images/icons/2-green.svg" alt="">@item.LuggageCount</span>
                                                <span class="d-atr"><img src="/rentaly-ui/Rentaly HTML/images/icons/5-green.svg" alt="">@item.FuelType</span>
                                                <span class="d-atr"><img src="/rentaly-ui/Rentaly HTML/images/icons/6-green.svg" alt="">@item.Year</span>
                                                <span class="d-atr"><img src="/rentaly-ui/Rentaly HTML/images/icons/7-green.svg" alt="">@item.Kilometer</span>
                                                <span class="d-atr"><img src="/rentaly-ui/Rentaly HTML/images/icons/8-green.svg" alt="">@item.DepositAmount</span>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-price">
                                        <div class=" padding10">
                                            Günlük ücret <span>@item.DailyPrice ₺</span>
                                            <a href="/Booking/Index?carId=@item.CarId" class="btn-main">Kirala</a>
                                        </div>

                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        }


                    </div>
                </div>
            </div>
        </div>
    </section>


</div>
<!-- content close -->
<!-- Javascript Files
================================================== -->
<script src="js/plugins.js"></script>
<script src="js/designesia.js"></script>

<script>
    const checkboxes = document.querySelectorAll('.single-select');
    const filterForm = document.getElementById('filterForm');

    checkboxes.forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
            if (this.checked) {
                const groupName = this.name;
                //eğer bu tıklandıysa diğer diğer tüm tikleri kaldır
                checkboxes.forEach(function(otherCheckbox) {
                    if (otherCheckbox.name === groupName && otherCheckbox !== checkbox) {
                        otherCheckbox.checked = false;
                    }
                });
            }
            filterForm.submit();
        });
    });

    document.addEventListener("DOMContentLoaded", function() {
        // Slider HTML elementlerini yakala
        const rangeInput = document.querySelectorAll(".range-input input");
        const progress = document.querySelector(".slider .progress");

        if (rangeInput.length > 0 && progress) {
            // C#'tan (Model'den) gelen ve kutuların içine yazılan değerleri al
            let minVal = parseInt(rangeInput[0].value);
            let maxVal = parseInt(rangeInput[1].value);

            // Slider'ın maksimum alabileceği değeri (max attribute) dinamik olarak al
            let maxLimit = parseInt(rangeInput[1].max);

            // Çubuğun (progress) sağdan ve soldan yüzde kaç içeride durması gerektiğini hesapla
            progress.style.left = (minVal / maxLimit) * 100 + "%";
            progress.style.right = 100 - (maxVal / maxLimit) * 100 + "%";
        }
    });

    // --- Sizin yazdığınız önceki kod (Otomatik form gönderme) burada kalmaya devam etsin ---
    document.querySelectorAll('.range-min, .range-max').forEach(slider => {
        slider.addEventListener('change', function() {
            this.closest('form').submit();
        });
    });
</script>

