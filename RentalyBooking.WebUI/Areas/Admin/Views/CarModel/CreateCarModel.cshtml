@model RentalyBooking.EntityLayer.Entities.CarModel

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Yeni Model Ekle</h5>
                <small class="text-muted float-end">Araç Seçenekleri</small>
            </div>
            <hr class="m-0" />

            <div class="card-body mt-3">
                <form asp-area="Admin" asp-controller="CarModel" asp-action="CreateCarModel" method="post">

                    <div class="mb-4">
                        <label class="form-label fw-bold text-primary" asp-for="BrandId">1. Marka Seçiniz</label>
                        <select class="form-select form-select-lg" asp-for="BrandId" asp-items="@ViewBag.Brands" required>
                            <option value="">-- Lütfen Bir Marka Seçin --</option>
                        </select>
                        <div class="form-text">Modelin bağlı olacağı ana markayı seçin.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-primary" asp-for="ModelName">2. Model Adı</label>
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-purchase-tag-alt"></i></span>
                            <input type="text" class="form-control form-control-lg" asp-for="ModelName" placeholder="Örn: 5 Serisi, Civic, Passat..." required />
                        </div>
                    </div>

                    <div class="mt-5 text-end">
                        <a asp-area="Admin" asp-controller="CarModel" asp-action="CarModelList" class="btn btn-outline-secondary me-2">
                            <i class="bx bx-arrow-back me-1"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Modeli Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>