@model List<RentalyBooking.EntityLayer.Entities.CarModel>

<div class="card mb-4 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Araç Model Listesi</h5>
        <a asp-area="Admin" asp-controller="CarModel" asp-action="CreateCarModel" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Yeni Model Ekle
        </a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover w-100">
            <thead>
                <tr>
                    <th class="ps-4">Bağlı Olduğu Marka</th>
                    <th>Model Adı</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-label-secondary fw-semibold fs-6 d-inline-flex align-items-center">
                                @if (item.Brand != null)
                                {
                                    @if (!string.IsNullOrEmpty(item.Brand.ImageUrl))
                                    {
                                        <img src="@item.Brand.ImageUrl"
                                             alt="@item.Brand.BrandName"
                                             class="me-2 rounded"
                                             style="width: 24px; height: 24px; object-fit: contain; background-color: transparent;"
                                             onerror="this.src='https://placehold.co/50x50/e2e8f0/94a3b8?text=?'" />
                                    }
                                    else
                                    {
                                        <i class="bx bx-car me-2"></i>
                                    }

                                    @item.Brand.BrandName
                                }
                                else
                                {
                                    <i class="bx bx-help-circle me-2"></i> @("Bilinmiyor")
                                }
                            </span>
                        </td>
                        <td>
                            <strong class="fs-5 text-primary">@item.ModelName</strong>
                        </td>
                        <td class="text-end pe-4">
                            <a href="/Admin/CarModel/UpdateCarModel/@item.CarModelId" class="btn btn-sm btn-outline-info me-2">
                                <i class="bx bx-edit-alt me-1"></i> Düzenle
                            </a>
                            <a href="/Admin/CarModel/DeleteCarModel/@item.CarModelId" class="btn btn-sm btn-outline-danger">
                                <i class="bx bx-trash me-1"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>