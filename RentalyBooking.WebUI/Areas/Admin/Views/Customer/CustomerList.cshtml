@model List<RentalyBooking.EntityLayer.Entities.Customer>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom">
        <h5 class="mb-0 fw-bold text-primary"><i class="bx bx-group me-2"></i>Müşteri Listesi</h5>
        <a asp-area="Admin" asp-controller="Customer" asp-action="CreateCustomer" class="btn btn-primary">
            <i class="bx bx-user-plus me-1"></i> Yeni Müşteri Ekle
        </a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Müşteri Bilgisi</th>
                    <th>İletişim</th>
                    <th>Kimlik / Ehliyet</th>
                    <th>Ehliyet Tarihi</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bx bx-user-x fs-1 mb-3"></i>
                            <p class="mb-0">Henüz kayıtlı müşteri bulunmuyor.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        // İsim ve Soyismin ilk harflerini alarak dinamik avatar oluşturuyoruz
                        string initials = (!string.IsNullOrEmpty(item.Name) ? item.Name.Substring(0, 1).ToUpper() : "") +
                        (!string.IsNullOrEmpty(item.Surname) ? item.Surname.Substring(0, 1).ToUpper() : "");

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar avatar-md me-3">
                                        <span class="avatar-initial rounded-circle bg-label-primary fw-bold">@initials</span>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@item.Name @item.Surname</h6>
                                        <small class="text-muted"><i class="bx bx-envelope"></i> @item.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-label-secondary fw-semibold">
                                    <i class="bx bx-phone"></i> @item.Phone
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="text-heading" style="font-size: 0.85rem;"><strong class="text-muted">TC:</strong> @item.IdentityNumber</span>
                                    <span class="text-heading" style="font-size: 0.85rem;"><strong class="text-muted">No:</strong> @item.DrivingLicenseNumber</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-label-info text-black">
                                    <i class="bx bx-calendar-check"></i> @item.DrivingLicenseDate.ToString("dd.MM.yyyy")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded fs-4 text-muted"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <a class="dropdown-item text-warning" href="/Admin/Customer/UpdateCustomer/@item.CustomerId">
                                            <i class="bx bx-edit-alt me-1"></i> Düzenle
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item text-danger" href="/Admin/Customer/DeleteCustomer/@item.CustomerId">
                                            <i class="bx bx-trash me-1"></i> Sil
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>