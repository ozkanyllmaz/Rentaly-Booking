@model List<RentalyBooking.EntityLayer.Entities.Category>

@{
    // Kartlar için sırayla dönecek Sneat pastel renk sınıfları
    string[] bgColors = {
        "vibrant-indigo",  // Primary
        "vibrant-gray",    // Secondary
        "vibrant-green",   // Success
        "vibrant-red",     // Danger
        "vibrant-orange",  // Warning
        "vibrant-cyan",    // Info
        "vibrant-purple",  // Türetilmiş Mor
        "vibrant-fuchsia", // Türetilmiş Fuşya
        "vibrant-blue",    // Türetilmiş Mavi
        "vibrant-teal"     // Türetilmiş Turkuaz
    };
    int colorIndex = 0;
}

<style>
    /* Kart Z-Index ve Hover Efekti (Korundu, hala harika çalışıyor) */
    .category-card {
        transition: all 0.2s ease-in-out;
        position: relative;
        z-index: 1;
        border-radius: 0.75rem; /* Köşeleri biraz daha yumuşattık */
    }

        .category-card:hover, .category-card:focus-within {
            transform: translateY(-5px);
            z-index: 10;
            box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.2) !important; /* Gölgeyi biraz daha koyulaştırdık */
        }

    /* ---- YÜKLENEN GÖRSELDEKİ (image_4.png) RENKLERİ TEMEL ALAN DÜZ CANLI RENK PALETİ ---- */
    /* Gradyan yerine düz 'background-color' kullanıyoruz */
    .vibrant-indigo {
        background-color: #6610f2;
    }
    /* Primary */
    .vibrant-gray {
        background-color: #6c757d;
    }
    /* Secondary */
    .vibrant-green {
        background-color: #28a745;
    }
    /* Success */
    .vibrant-red {
        background-color: #dc3545;
    }
    /* Danger */
    .vibrant-orange {
        background-color: #fd7e14;
    }
    /* Warning */
    .vibrant-cyan {
        background-color: #17a2b8;
    }
    /* Info */

    /* ---- TÜRETİLMİŞ EK CANLI RENKLER ---- */
    .vibrant-purple {
        background-color: #6f42c1;
    }
    /* Daha koyu mor */
    .vibrant-fuchsia {
        background-color: #d63384;
    }
    /* Pembe-mor */
    .vibrant-blue {
        background-color: #0d6efd;
    }
    /* Temel mavi */
    .vibrant-teal {
        background-color: #20c997;
    }
    /* Daha koyu turkuaz */
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold py-3 mb-0"><span class="text-muted fw-light">Kategoriler /</span> Kategori Listesi</h4>
    <a asp-area="Admin" asp-controller="Category" asp-action="CreateCategory" class="btn btn-primary">
        <i class="bx bx-plus me-1"></i> Yeni Kategori Ekle
    </a>
</div>

<div class="row g-4">
    @if (Model.Count == 0)
    {
        <div class="col-12">
            <div class="card shadow-sm text-center" style="padding: 4rem 2rem;">
                <div class="card-body">
                    <i class="bx bx-category text-muted mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                    <h5 class="fw-bold text-secondary">Henüz Kategori Bulunmuyor</h5>
                    <p class="text-muted">Araçlarınızı sınıflandırmak için hemen bir kategori ekleyin.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            // Sıradaki rengi al ve sayacı bir artır
            string currentBg = bgColors[colorIndex % bgColors.Length];
            colorIndex++;

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 category-card @currentBg">
                    <div class="card-body d-flex justify-content-between align-items-start">

                        <div>
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar avatar-sm me-2">
                                    <span class="avatar-initial rounded bg-white text-dark shadow-sm">
                                        <i class="bx bx-purchase-tag"></i>
                                    </span>
                                </div>
                                <h5 class="card-title text-heading mb-0 fw-bold text-white">@item.CategoryName</h5>
                            </div>

                            <span class="badge bg-white text-dark rounded-pill mt-2 px-3 py-2 shadow-sm">
                                <i class="bx bx-car me-1 text-primary"></i> @(item.Cars != null ? item.Cars.Count : 0) Araç
                            </span>
                        </div>

                        <div class="dropdown">
                            <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                <i class="bx bx-dots-vertical-rounded fs-4 text-white"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg">
                                <a class="dropdown-item text-info" href="/Admin/Car/CarsByCategory/@item.CategoryId">
                                    <i class="bx bx-car me-1"></i> Araçları Gör
                                </a>
                                <a class="dropdown-item text-warning" href="/Admin/Category/UpdateCategory/@item.CategoryId">
                                    <i class="bx bx-edit-alt me-1"></i> Düzenle
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="/Admin/Category/DeleteCategory/@item.CategoryId">
                                    <i class="bx bx-trash me-1"></i> Sil
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    }
</div>