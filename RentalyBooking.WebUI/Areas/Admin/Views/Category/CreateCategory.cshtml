@model RentalyBooking.EntityLayer.Entities.Category

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header border-bottom">
                <h5 class="mb-0 text-primary"><i class="bx bx-plus-circle me-2"></i>Yeni Kategori Ekle</h5>
            </div>

            <div class="card-body mt-4">
                <form asp-area="Admin" asp-controller="Category" asp-action="CreateCategory" method="post">

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary" asp-for="CategoryName">Kategori Adı</label>
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-purchase-tag"></i></span>
                            <input type="text" class="form-control form-control-lg" asp-for="CategoryName" placeholder="Örn: SUV, Sedan, Hatchback..." required />
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-5">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bx bx-save me-1"></i> Kategoriyi Kaydet
                        </button>
                        <a asp-area="Admin" asp-controller="Category" asp-action="CategoryList" class="btn btn-label-secondary btn-lg">
                            İptal Et
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>