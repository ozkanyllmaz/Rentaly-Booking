@model List<RentalyBooking.EntityLayer.Entities.Brand>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Marka Listesi</h5>
        <a asp-area="Admin" asp-controller="Brand" asp-action="CreateBrand" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Yeni Marka Ekle
        </a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover w-100">
            <thead>
                <tr>
                    <th class="w-25 ps-4">Logo</th>

                    <th class="w-50 text-center">Marka Adı</th>

                    <th class="w-25 text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="w-25 align-middle ps-4">
                            <img src="@item.ImageUrl"
                                 alt="@item.BrandName Logo"
                                 class="rounded"
                                 style="height: 45px; width: auto; max-width: 90px; object-fit: contain;"
                                 data-bs-toggle="tooltip"
                                 data-bs-placement="top"
                                 title="@item.BrandName" />
                        </td>

                        <td class="w-50 text-xl-center fs-5 fw-semibold align-middle">
                            @item.BrandName
                        </td>

                        <td class="w-25 text-end align-middle pe-4">
                            <a href="/Admin/Brand/UpdateBrand/@item.BrandId" class="btn btn-sm btn-outline-info me-2">
                                <i class="bx bx-edit-alt me-1"></i> Düzenle
                            </a>
                            <a href="/Admin/Brand/DeleteBrand/@item.BrandId" class="btn btn-sm btn-outline-danger">
                                <i class="bx bx-trash me-1"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>