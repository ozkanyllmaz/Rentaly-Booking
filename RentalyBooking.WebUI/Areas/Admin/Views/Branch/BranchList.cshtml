@model List<RentalyBooking.EntityLayer.Entities.Branch>

<div class="card mb-4 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Şube Listesi</h5>
        <a asp-area="Admin" asp-controller="Branch" asp-action="CreateBranch" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Yeni Şube Ekle
        </a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Şube Adı</th>
                    <th>Şehir</th>
                    <th>Açık Adres</th>
                    <th class="text-center">Araç Sayısı</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <i class="bx bx-building-house fa-lg text-primary me-2"></i>
                            <strong>@item.BranchName</strong>
                        </td>
                        <td><span class="badge bg-label-info">@item.City</span></td>

                        <td class="text-truncate" style="max-width: 250px;" title="@item.Address">
                            @item.Address
                        </td>

                        <td class="text-center">
                            <span class="badge bg-label-success rounded-pill">
                                @(item.Cars != null ? item.Cars.Count : 0) Araç
                            </span>
                        </td>

                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-info" href="/Admin/Car/GetCarsByBranchId/@item.BranchId">
                                        <i class="bx bx-car me-1"></i> Araçları Gör
                                    </a>
                                    <a class="dropdown-item text-warning" href="/Admin/Branch/UpdateBranch/@item.BranchId">
                                        <i class="bx bx-edit-alt me-1"></i> Düzenle
                                    </a>
                                    <a class="dropdown-item text-danger" href="/Admin/Branch/DeleteBranch/@item.BranchId">
                                        <i class="bx bx-trash me-1"></i> Sil
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>