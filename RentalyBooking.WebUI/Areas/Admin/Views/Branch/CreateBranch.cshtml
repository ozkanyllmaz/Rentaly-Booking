@model RentalyBooking.EntityLayer.Entities.Branch

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Yeni Şube Ekle</h5>
                <small class="text-muted float-end">Şube Yönetimi</small>
            </div>
            <hr class="m-0" />

            <div class="card-body mt-3">
                <form asp-area="Admin" asp-controller="Branch" asp-action="CreateBranch" method="post">

                    <div class="mb-4">
                        <label class="form-label fw-bold" asp-for="BranchName">Şube Adı</label>
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-building"></i></span>
                            <input type="text" class="form-control" asp-for="BranchName" placeholder="Örn: Kadıköy Merkez Şube" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold" asp-for="City">Bulunduğu Şehir</label>
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-map"></i></span>
                            <input type="text" class="form-control" asp-for="City" placeholder="Örn: İstanbul" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold" asp-for="Address">Açık Adres</label>
                        <textarea class="form-control" asp-for="Address" rows="3" placeholder="Mahalle, sokak, no..." required></textarea>
                    </div>

                    <div class="mt-5 text-end">
                        <a asp-area="Admin" asp-controller="Branch" asp-action="BranchList" class="btn btn-outline-secondary me-2">
                            <i class="bx bx-arrow-back me-1"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> Şubeyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>