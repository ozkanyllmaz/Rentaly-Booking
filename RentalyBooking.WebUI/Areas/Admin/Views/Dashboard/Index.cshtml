@model RentalyBooking.WebUI.Areas.Admin.Models.DashboardViewModel

<div class="row">
    <div class="col-12 col-lg-8">

        <div class="card shadow-sm border-0 mb-4">
            <div class="d-flex align-items-end row">
                <div class="col-sm-7">
                    <div class="card-body">
                        <h5 class="card-title text-primary">Hoş Geldin Özkan! 🎉</h5>
                        <p class="mb-4">
                            Sistemin harika çalışıyor. Bugüne kadar tamamlanan kiralamalardan toplam
                            <span class="fw-bold text-success">₺@Model.TotalRevenue.ToString("N2")</span>
                            ciro elde ettin.
                        </p>
                        <a href="/Admin/Rentaly/RentalyList" class="btn btn-sm btn-outline-primary">Rezervasyonları İncele</a>
                    </div>
                </div>
                <div class="col-sm-5 text-center text-sm-left">
                    <div class="card-body pb-0 px-0 px-md-4">
                        <img src="~/sneat/assets/img/illustrations/man-with-laptop-light.png" height="140" alt="View Badge User" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card shadow-none border border-primary bg-label-primary h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="card-body text-center p-3">
                        <i class="bx bx-buildings fs-1 mb-2 text-primary"></i>
                        <h4 class="mb-1 text-primary fw-bold">@Model.TotalBranches</h4>
                        <span class="fw-semibold text-primary" style="font-size: 0.8rem;">Toplam Şube</span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card shadow-none border border-success bg-label-success h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="card-body text-center p-3">
                        <i class="bx bx-car fs-1 mb-2 text-success"></i>
                        <h4 class="mb-1 text-success fw-bold">@Model.TotalCars</h4>
                        <span class="fw-semibold text-success" style="font-size: 0.8rem;">Filo Büyüklüğü</span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card shadow-none border border-info bg-label-info h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="card-body text-center p-3">
                        <i class="bx bx-check-double fs-1 mb-2 text-info"></i>
                        <h4 class="mb-1 text-info fw-bold">@Model.CompletedRentals</h4>
                        <span class="fw-semibold text-info" style="font-size: 0.8rem;">Başarılı İşlem</span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card shadow-none border border-warning bg-label-warning h-100" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="card-body text-center p-3">
                        <i class="bx bx-pulse fs-1 mb-2 text-warning"></i>
                        <h4 class="mb-1 text-warning fw-bold">12</h4>
                        <span class="fw-semibold text-warning" style="font-size: 0.8rem;">Bugünkü Aksiyon</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="row row-bordered g-0 h-100">
                <div class="col-md-8">
                    <h5 class="card-header m-0 me-2 pb-3">Aylık Kiralama Hacmi</h5>
                    <div id="totalRevenueChart" class="px-2" style="min-height: 300px;"></div>
                </div>
                
                <div class="col-md-4">
                    <div class="card-body">
                        <div class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    2026 Yılı
                                </button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" href="javascript:void(0);">2025 Yılı</a>
                                    <a class="dropdown-item" href="javascript:void(0);">2024 Yılı</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="growthChart"></div>
                    <div class="text-center fw-semibold pt-3 mb-2">62% Şirket Büyümesi</div>

                    <div class="d-flex px-xxl-4 px-lg-2 p-4 gap-xxl-3 gap-lg-1 gap-3 justify-content-center">
                        <div class="d-flex">
                            <div class="me-2">
                                <span class="badge bg-label-primary p-2"><i class="bx bx-wallet text-primary"></i></span>
                            </div>
                            <div class="d-flex flex-column">
                                <small>Geçen Ay</small>
                                <h6 class="mb-0">₺12.5k</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <h5 class="card-header m-0 pb-3">Son Kiralama İşlemleri</h5>
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Müşteri</th>
                            <th>Alış Tarihi</th>
                            <th>İade Tarihi</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var item in Model.RecentRentals)
                        {
                            <tr>
                                <td>
                                    <strong>@(item.Customer != null ? $"{item.Customer.Name} {item.Customer.Surname}" : "Müşteri Bilgisi Yok")</strong>
                                </td>

                                <td>@item.PickupDate.ToString("dd MMM yyyy")</td>
                                <td>@item.ReturnDate.ToString("dd MMM yyyy")</td>

                                <td>₺@item.TotalPrice.ToString("N2")</td>

                                <td>
                                    @if (item.Status != null && item.Status.Trim().ToLower() == "tamamlandı")
                                    {
                                        <span class="badge bg-label-success">Tamamlandı</span>
                                    }
                                    else if (item.Status != null && item.Status.Trim().ToLower() == "aktif")
                                    {
                                        <span class="badge bg-label-warning">Aktif Sürüş</span>
                                    }
                                    else if (item.Status != null && item.Status.Trim().ToLower() == "beklemede")
                                    {
                                        <span class="badge bg-label-danger">Beklemede</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-info">@item.Status</span>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.RecentRentals.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Henüz kiralama işlemi bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="col-12 col-lg-4 d-flex flex-column">

        <div class="row">
            <div class="col-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-key fs-4"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Aktif Sürüş</span>
                        <h3 class="card-title mb-2">@Model.ActiveRentedCars</h3>
                        <small class="text-warning fw-semibold"><i class="bx bx-up-arrow-alt"></i> Yolda</small>
                    </div>
                </div>
            </div>

            <div class="col-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-success"><i class="bx bx-check-shield fs-4"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Müsait Araçlar</span>
                        <h3 class="card-title text-nowrap mb-1">@Model.AvailableCars</h3>
                        <small class="text-success fw-semibold"><i class="bx bx-check"></i> Garajda</small>
                    </div>
                </div>
            </div>

            <div class="col-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-info"><i class="bx bx-group fs-4"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Müşteriler</span>
                        <h3 class="card-title mb-2">@Model.TotalCustomers</h3>
                        <small class="text-info fw-semibold"><i class="bx bx-trending-up"></i> +12%</small>
                    </div>
                </div>
            </div>

            <div class="col-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-danger"><i class="bx bx-time-five fs-4"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Bekleyen İşlem</span>
                        <h3 class="card-title text-nowrap mb-1">@Model.PendingRentals</h3>
                        <small class="text-danger fw-semibold">Onay Bekliyor</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header d-flex align-items-center justify-content-between pb-0">
                <div class="card-title mb-0">
                    <h5 class="m-0 me-2 text-primary"><i class="bx bx-gas-pump me-2"></i>Akaryakıt Piyasası</h5>
                    <small class="text-muted">Canlı Piyasa Verileri</small>
                </div>
                <div class="dropdown">
                    <button class="btn p-0" type="button" data-bs-toggle="dropdown"><i class="bx bx-dots-vertical-rounded"></i></button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" href="javascript:void(0);"><i class="bx bx-refresh me-1"></i> Yenile</a>
                    </div>
                </div>
            </div>
            <div class="card-body mt-4">
                <ul class="p-0 m-0">
                    <li class="d-flex mb-4 pb-1">
                        <div class="avatar flex-shrink-0 me-3">
                            <span class="avatar-initial rounded bg-label-danger"><i class="bx bx-droplet fs-4"></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <h6 class="mb-0">Kurşunsuz Benzin 95</h6>
                                <small class="text-muted">Litre Fiyatı</small>
                            </div>
                            <div class="user-progress">
                                <small class="fw-bold fs-5 text-dark">@Model.GasolinePrice</small>
                            </div>
                        </div>
                    </li>

                    <li class="d-flex mb-4 pb-1">
                        <div class="avatar flex-shrink-0 me-3">
                            <span class="avatar-initial rounded bg-label-dark"><i class="bx bx-tachometer fs-4"></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <h6 class="mb-0">Motorin (Dizel)</h6>
                                <small class="text-muted">Litre Fiyatı</small>
                            </div>
                            <div class="user-progress">
                                <small class="fw-bold fs-5 text-dark">@Model.DieselPrice</small>
                            </div>
                        </div>
                    </li>

                    <li class="d-flex">
                        <div class="avatar flex-shrink-0 me-3">
                            <span class="avatar-initial rounded bg-label-info"><i class="bx bx-cylinder fs-4"></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <h6 class="mb-0">Otogaz (LPG)</h6>
                                <small class="text-muted">Litre Fiyatı</small>
                            </div>
                            <div class="user-progress">
                                <small class="fw-bold fs-5 text-dark">@Model.LpgPrice</small>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4 flex-grow-1">
            <div class="card-header pb-0 mb-4">
                <div class="card-title mb-0">
                    <h5 class="m-0 me-2">Filo Dağılımı</h5>
                    <small class="text-muted">Kategori Bazlı Araç Sayısı</small>
                </div>
            </div>
            <div class="card-body mt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex flex-column align-items-center gap-1">
                        <h2 class="mb-0 display-6 fw-normal text-dark">@Model.TotalCars</h2>
                        <span class="text-muted fw-semibold">Toplam Araç</span>
                    </div>
                    <div id="dynamicFleetChart"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/sneat/assets/vendor/libs/apex-charts/apexcharts.js"></script>

    <script src="~/sneat/assets/js/dashboards-analytics.js"></script>


    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // C# Backend'den kategori adlarını ve sayılarını alıyoruz
            var categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCarCounts.Keys));
            var categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCarCounts.Values));

            const chartElement = document.querySelector('#dynamicFleetChart');

            if (chartElement) {
                const chartConfig = {
                    chart: {
                        height: 165,
                        width: 130, // Kartın sağına tam oturması için orijinal genişlik
                        type: 'donut'
                    },
                    labels: categoryLabels, // "Sports" yerine senin kategorilerin yazacak (Örn: SUV)
                    series: categoryData,   // O kategorideki araç sayısı
                    colors: ['#71dd37', '#696cff', '#03c3ec', '#ffab00', '#ff3e1d', '#8592a3'], // Orijinal Sneat renkleri
                    stroke: {
                        width: 5,
                        colors: ['#fff']
                    },
                    dataLabels: {
                        enabled: false // Grafiğin üzerinde sabit yazı çıkmasın, sadece hover olunca çıksın
                    },
                    legend: {
                        show: false // Kenardaki gereksiz ikon listesini gizler
                    },
                    grid: {
                        padding: {
                            top: 0,
                            bottom: 0,
                            right: 15
                        }
                    },
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '75%',
                                labels: {
                                    show: true,
                                    value: {
                                        fontSize: '1.5rem',
                                        fontFamily: 'Public Sans',
                                        color: '#566a7f',
                                        offsetY: -15,
                                        formatter: function (val) {
                                            return val; // Ortada aracın sayısını gösterir
                                        }
                                    },
                                    name: {
                                        offsetY: 20,
                                        fontFamily: 'Public Sans'
                                    },
                                    total: {
                                        show: true,
                                        fontSize: '0.8125rem',
                                        color: '#a1acb8',
                                        label: 'Toplam',
                                        formatter: function (w) {
                                            return @Model.TotalCars; // Ortada varsayılan olarak yazacak değer
                                        }
                                    }
                                }
                            }
                        }
                    }
                };

                const myChart = new ApexCharts(chartElement, chartConfig);
                myChart.render();
            }
        });
    </script>
}
